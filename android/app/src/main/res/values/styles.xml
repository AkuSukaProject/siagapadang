<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.SiagaPadang" parent="android:style/Theme.Material.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:windowBackground">#01346D</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:navigationBarColor">#01346D</item>
        <item name="android:statusBarColor">#01346D</item>
    </style>

    <style name="Theme.SiagaPadang.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/ic_launcher_background</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/siaga_padang_splash_logo</item>
        <item name="windowSplashScreenAnimationDuration">300</item>
        <item name="postSplashScreenTheme">@style/Theme.SiagaPadang</item>
    </style>
</resources>
