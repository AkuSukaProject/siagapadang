            "title": "Lintang",
            "default": ""
          },
          "bujur": {
            "type": "string",
            "title": "Bujur",
            "default": ""
          },
          "magnitude": {
            "type": "string",
            "title": "Magnitude",
            "default": ""
          },
          "kedalaman": {
            "type": "string",
            "title": "Kedalaman",
            "default": ""
          },
          "wilayah": {
            "type": "string",
            "title": "Wilayah",
            "default": ""
          },
