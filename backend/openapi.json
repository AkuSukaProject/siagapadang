      "get": {
        "tags": [
          "Synchronization"
        ],
        "summary": "Get Sync Network",
        "description": "Mengunduh paket SQLite lengkap yang sudah diverifikasi terhadap metadata aktif.",
        "operationId": "get_sync_network_api_v1_sync_network_get",
        "parameters": [
          {
            "name": "version",
            "in": "query",
