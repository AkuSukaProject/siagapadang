{
  "openapi": "3.1.0",
  "info": {
    "title": "API Evakuasi Tsunami Padang (Offline-First Backend)",
    "description": "Backend untuk sinkronisasi data prabencana dan simulasi bottleneck.",
    "version": "1.0.0"
  },
  "paths": {
    "/api/v1/sync/check": {
      "get": {
        "tags": [
          "Synchronization"
        ],
        "summary": "Check Updates",
        "description": "Endpoint untuk mendapatkan metadata versi terbaru dari semua dataset yang aktif.\nAndroid akan membandingkan daftar ini dengan versi lokal SQLite-nya.",
        "operationId": "check_updates_api_v1_sync_check_get",
        "parameters": [
          {
            "name": "dataset_name",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Dataset Name"
            }
          },
          {
            "name": "current_version",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Current Version"
            }
          },
          {
            "name": "current_checksum",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Current Checksum"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SyncCheckResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/sync/shelters": {
      "get": {
        "tags": [
          "Synchronization"
        ],
        "summary": "Get Sync Shelters",
        "description": "Mengunduh seluruh data shelter beserta metadata (elevasi, kapasitas, akses masuk) dalam format GeoJSON standar.",
        "operationId": "get_sync_shelters_api_v1_sync_shelters_get",
        "responses": {
          "200": {
