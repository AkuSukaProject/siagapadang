            "type": "string",
            "enum": [
              "live",
              "stale"
            ],
            "title": "Data Status",
            "description": "Status kesegaran data: live atau stale",
            "default": "live"
          },
          "fetched_at": {
            "type": "string",
            "format": "date-time",
            "title": "Fetched At",
            "description": "Waktu pengambilan data dari BMKG dalam format ISO 8601 UTC"
          },
          "source": {
            "type": "string",
            "title": "Source",
            "description": "Atribusi sumber data resmi sesuai ketentuan lisensi BMKG",
            "default": "BMKG (Badan Meteorologi, Klimatologi, dan Geofisika)"
          }
        },
        "type": "object",
        "required": [
          "fetched_at"
        ],
        "title": "BMKGStatusResponse"
      },
      "CheckInRequest": {
        "properties": {
          "event_external_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
